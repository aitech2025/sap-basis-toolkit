# Database: use PostgreSQL in shared/production deployments.
DATABASE_URL=sqlite:///./data/sentinel.db
# DATABASE_URL=postgresql+psycopg://sentinel:change-me@localhost:5432/sentinel
CHECK_INTERVAL_MINUTES=360
CERTIFICATE_TIMEOUT_SECONDS=8
ALERT_THRESHOLDS_DAYS=90,60,30,14,7
# Generic JSON webhook; compatible with Slack/Teams incoming-webhook endpoints.
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAIL_TO=
