# Copy to .env and replace all placeholder secrets before starting Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_AUTH_TOKEN=replace-with-a-long-random-api-token
# Mandatory: comma-separated exact hostnames or wildcard subdomains.
ALLOWED_TARGET_HOSTS=sapqa.corp.example.com
# Private SAP network ranges only; keep as narrow as possible.
ALLOWED_TARGET_CIDRS=10.20.0.0/16
# HTTPS ports only; add SAP ICM HTTPS ports only when needed.
ALLOWED_TARGET_PORTS=443,44300
CHECK_INTERVAL_MINUTES=360
CERTIFICATE_TIMEOUT_SECONDS=8
DEFAULT_WARNING_DAYS=30
ALERT_THRESHOLDS_DAYS=90,60,30,14,7
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAIL_TO=
# Webhook format: generic | slack | teams (Teams = Workflows webhook with Adaptive Card)
ALERT_WEBHOOK_FORMAT=generic
# PagerDuty Events API v2 integration key (critical/error alerts only for toolkit modules)
PAGERDUTY_ROUTING_KEY=
# Table growth watchdog
GROWTH_ALERT_DAYS=30
GROWTH_CAPACITY_THRESHOLD_PCT=90
GROWTH_EVAL_INTERVAL_MINUTES=1440
# User & license optimizer
DORMANT_USER_DAYS=90
PROTECTED_USERS=SAP*,DDIC,TMSADM,EARLYWATCH,SAPCPIC
# Transport checker: table content that requires explicit approval
PROTECTED_TABLES=T000,USR01,USR02,USR04,UST04,AGR_USERS,RFCDES,TBTCO,TBTCP,TVARVC,PRGN_CUST,SSM_CUST
MAX_UPLOAD_BYTES=20971520
# Operations monitoring
JOB_LONG_RUNNING_MINUTES=120
LOCK_WARNING_MINUTES=60
LOCK_CRITICAL_MINUTES=240
OPS_DATA_STALE_HOURS=24
OPS_RETENTION_DAYS=90
# --- Platform -----------------------------------------------------------------
# Signs sessions and encrypts collector credentials. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-random-hex-characters
SESSION_HOURS=12
# Optional: create the first admin at startup (otherwise use first-run setup in the UI with API_AUTH_TOKEN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# --- Live collectors ------------------------------------------------------------
# sapcontrol hosts (5<NN>13/14) and HANA hosts (3<NN>xx) must be in ALLOWED_TARGET_HOSTS / ALLOWED_TARGET_CIDRS
COLLECTOR_TICK_SECONDS=15
COLLECTOR_TIMEOUT_SECONDS=15
# Collector runs in flight at once (scheduler worker). 16 handles ~50 systems at 5-minute intervals; see docs/scaling.md.
COLLECTOR_MAX_PARALLEL=16
# Default interval for sapcontrol collectors created by discovery (live ABAP signals)
SAPCONTROL_INTERVAL_SECONDS=60
SAPCONTROL_INSTANCE_PARALLEL=4
# Live SM12 lock snapshots: store every N seconds, keeping locks held at least N minutes
LOCK_SNAPSHOT_SECONDS=300
LOCK_STORE_MIN_AGE_MINUTES=5
CERT_CHECK_PARALLEL=8
# Database connections per process (the scheduler raises its own pool to COLLECTOR_MAX_PARALLEL + CERT_CHECK_PARALLEL + 4).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
INTELLIGENCE_CACHE_SECONDS=60
WP_LONG_RUNNING_SECONDS=1800
METRIC_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_FULL_RESOLUTION_HOURS=24
QUERY_OVERRIDES_FILE=
# Build the image with the SAP HANA client (hdbcli, SAP Developer License)
HANA_CLIENT=true
# Discovery: TCP probe of sapstartsrv ports 5<NN>13/14 for instance numbers 00-99
DISCOVERY_PROBE_TIMEOUT_SECONDS=0.8
DISCOVERY_MAX_PARALLEL=48
# OS discovery / inventory over SSH (read-only commands, host keys pinned on first use)
SSH_ALLOWED_PORTS=22
SSH_TIMEOUT_SECONDS=15
# Start/stop/restart through sapstartsrv (admin only; PRD systems need an explicit per-system opt-in)
CONTROL_ENABLED=true
CONTROL_TIMEOUT_SECONDS=1200
CONTROL_POLL_SECONDS=5
# Demo only: collectors with host "simulator" (or "simulator-<sid>" for discovery) produce synthetic data. Never enable in production.
SIMULATOR_ENABLED=false
