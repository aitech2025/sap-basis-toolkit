# Copy to .env and replace all placeholder secrets before starting Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_AUTH_TOKEN=replace-with-a-long-random-api-token
# Mandatory: comma-separated exact hostnames or wildcard subdomains.
ALLOWED_TARGET_HOSTS=sapqa.corp.example.com
# Private SAP network ranges only; keep as narrow as possible.
ALLOWED_TARGET_CIDRS=10.20.0.0/16
# HTTPS ports only; add SAP ICM HTTPS ports only when needed.
ALLOWED_TARGET_PORTS=443,44300
CHECK_INTERVAL_MINUTES=360
CERTIFICATE_TIMEOUT_SECONDS=8
DEFAULT_WARNING_DAYS=30
ALERT_THRESHOLDS_DAYS=90,60,30,14,7
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAIL_TO=
